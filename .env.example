# Copy to .env.local. Leave the Supabase lines out to run the browser-only demo (no accounts, no server).
ANTHROPIC_API_KEY=

# Server mode (F10). Local: run `npx supabase start` and copy the URL, publishable key and secret key it prints.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 1 = the browser reaches Supabase through the app's own address (one port to open). Use when Supabase
# runs on the same machine as the app but the browser is on another computer.
NEXT_PUBLIC_SUPABASE_PROXY=
# Server only: creates accounts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
